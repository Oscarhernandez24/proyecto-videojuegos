# --- Base de datos MySQL ---
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=bd_blog_videojuegos

# --- Seguridad (sesiones JWT) ---
# Cambia esta clave por una cadena larga y aleatoria. Ejemplo para generarla:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
TOKEN_EXPIRE_MINUTES=120

# --- Recuperación de contraseña ---
# DEV_MODE=true muestra el código de recuperación en la consola del servidor y
# en la respuesta de la API (útil sin servidor de correo). Ponlo en false al publicar.
DEV_MODE=true
# SMTP opcional (si SMTP_HOST está vacío el código no se envía por correo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
